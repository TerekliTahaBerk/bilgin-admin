BILGIN_API_URL=http://localhost:8000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_MAX_AGE_SECONDS=28800

# Optional. When set, every unhandled client-side error (a caught render
# crash, a window `error`/`unhandledrejection` event) is also POSTed here as
# JSON, best-effort. Leave unset to rely on console-only reporting, which
# still reaches the deployment's own log collector.
# NEXT_PUBLIC_ERROR_REPORTING_URL=https://your-collector.example.com/errors
